# Copy to .env.local and set these values to enable shared family mode.
# Use ONLY the Supabase public / publishable key. Never put secret/service_role keys in the browser app.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY

# Legacy projects may still expose an anon key. The app also supports:
# VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
